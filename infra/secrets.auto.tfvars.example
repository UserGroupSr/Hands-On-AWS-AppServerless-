# =============================================================================
#  MODELO DE CREDENCIAIS  (este arquivo .example É versionado no git)
# =============================================================================
#  COMO USAR:
#    1. Copie este arquivo para  secrets.auto.tfvars
#         (Windows PowerShell:  Copy-Item secrets.auto.tfvars.example secrets.auto.tfvars )
#    2. Cole suas chaves reais no secrets.auto.tfvars
#    3. Rode o terraform normalmente (ele carrega *.auto.tfvars sozinho)
#
#  ⚠️  NUNCA coloque chave real NESTE arquivo .example — ele vai pro git!
#      O arquivo real (secrets.auto.tfvars) é ignorado pelo .gitignore.
# =============================================================================

aws_region     = "us-east-1"
aws_access_key = "COLE_SUA_ACCESS_KEY_AQUI"
aws_secret_key = "COLE_SUA_SECRET_KEY_AQUI"

# Só para credenciais temporárias (AWS Academy / Learner Lab).
# Se for chave normal de usuário IAM, deixe como está (string vazia).
aws_session_token = ""
